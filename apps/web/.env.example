# Copy to .env (never commit .env). Free key: https://build.nvidia.com -> any model -> "Get API Key"
NVIDIA_API_KEY=nvapi-...
# Optional overrides
# NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# NIM_TEXT_MODEL=meta/llama-3.2-90b-vision-instruct

# Home monitor (RuView on the Arduino UNO Q hub). Printed by hub/uno-q/setup.sh
# RUVIEW_URL=http://<uno-q-ip>:3000
# RUVIEW_API_TOKEN=<token from the hub>
