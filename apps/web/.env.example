# Copy to .env (never commit .env). Free key: https://build.nvidia.com -> any model -> "Get API Key"
NVIDIA_API_KEY=nvapi-...
# Optional overrides
# NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# NIM_TEXT_MODEL=meta/llama-3.2-90b-vision-instruct

# Home monitor (RuView on the Arduino UNO Q hub). Printed by hub/uno-q/setup.sh
# RUVIEW_URL=http://<uno-q-ip>:3000
# RUVIEW_API_TOKEN=<token from the hub>
# The laptop joins as a 2nd sensing link automatically with npm run dev (needs: sudo apt install iw).
# FITMAX_AGENT=0                    (turn the laptop link off)
# FITMAX_BLE_PEER=AA:BB:CC:DD:EE:FF (optional 3rd link: the board's Bluetooth address from ./setup.sh ble; pip install --user bleak)

# Aerial imagery for the 3D space builder (Vexcel API 2.0). Your Vexcel Viewer login.
# VEXCEL_API_KEY=            (a key from the CoStar sponsors; or use the login below)
# VEXCEL_USERNAME=
# VEXCEL_PASSWORD=

# Only-me tracking: your phone's fixed IP on the home WiFi (reserve it in your router)
# ME_PHONE_IP=192.168.1.23
# ME_PHONE_MAC=aa:bb:cc:dd:ee:ff   (optional; the iPhone's fixed private WiFi address)

# Matterport (tour view in the 3D builder). Register localhost:5173 as an SDK domain.
# MATTERPORT_SDK_KEY=
# MATTERPORT_TOKEN_ID=
# MATTERPORT_TOKEN_SECRET=
